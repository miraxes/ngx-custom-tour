    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "19.2.12",
    "@angular/cli": "19.2.12",
    "@angular/compiler-cli": "19.2.12",

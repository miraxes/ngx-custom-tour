  "repository": {
    "type": "git",
    "url": "git+https://github.com/miraxes/ngx-custom-tour.git"
  },
  "license": "MIT",
  "keywords": [
    "angular19",
    "angular20",
    "ng",
    "ngx",
    "hint",
    "step",
